{
  "name": "the-wyrnlands",
  "productName": "The Wyrnlands",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "electron": "node scripts/run-electron.mjs",
    "package": "npm run build && electron-builder --dir",
    "package:installer": "npm run build && electron-builder",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:native && npm run build",
    "sim:headless": "tsx src/engine/headless-runner.ts",
    "sim:perf": "tsx src/engine/perf/longRun.ts",
    "sim:activities": "node scripts/electron-node.mjs node_modules/tsx/dist/cli.mjs src/engine/perf/activityScale.ts",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:packaged": "node scripts/electron-smoke.mjs --packaged",
    "validate:desktop": "npm run validate && npm run test:electron && npm run package && npm run test:packaged",
    "bench:app": "node scripts/bench-electron.mjs",
    "bench:renderer": "node scripts/bench-renderer.mjs",
    "test:native": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
    "sim:perf:electron": "node scripts/electron-node.mjs node_modules/tsx/dist/cli.mjs src/engine/perf/longRun.ts"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "description": "The Wyrnlands — an offline medieval life simulation (desktop).",
  "main": "dist-electron/main.cjs"
}
